# Copy to .env. Everything is optional: without an LLM key, briefs use a built-in template.

# Gemini via its OpenAI-compatible endpoint. Key: https://aistudio.google.com/apikey
# (Any OpenAI-compatible API works: e.g. OpenAI = https://api.openai.com/v1 + gpt-4o-mini)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite

# Stretch: ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Turso hosted database (optional)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Websites allowed to call the API (comma-separated). Default: local dev server.
ALLOWED_ORIGINS=http://localhost:5173
# Max screenings per visitor per minute
RATE_LIMIT_PER_MIN=10
