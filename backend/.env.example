# Copy to .env. Everything is optional: without an LLM key, briefs use a built-in template.

# Gemini via its OpenAI-compatible endpoint. Key: https://aistudio.google.com/apikey
# (Any OpenAI-compatible API works: e.g. OpenAI = https://api.openai.com/v1 + gpt-4o-mini)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite

# Stretch: ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Turso hosted database (optional)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
