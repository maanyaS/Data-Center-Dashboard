{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "before-the-build-api": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": { "maxDuration": 60 }
      }
    },
    "before-the-build-web": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "before-the-build-api" } },
    { "source": "/(.*)", "destination": { "service": "before-the-build-web" } }
  ]
}
