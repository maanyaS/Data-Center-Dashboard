{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/{app/**,rules.yaml,seed.yaml,projects.csv}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.py" }]
}
